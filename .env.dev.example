# APP_ENV=dev로 실행할 때 사용하는 원격(운영) Supabase 설정입니다.
# .env.dev로 복사한 뒤 기존 운영 프로젝트의 접속 정보를 입력합니다.
# 실제 .env.dev는 Git에서 제외됩니다.
APP_ENV=dev
AUTH_PROVIDER=supabase
# 예: https://<운영_프로젝트>.supabase.co
SUPABASE_URL=
# Settings > API Keys의 Publishable / Secret 키
SUPABASE_PUBLISHABLE_KEY=
# 서버 전용: 브라우저에 전달하지 않습니다.
SUPABASE_SECRET_KEY=
DATA_DIR=data/dev
MOTION_MODEL_PATH=data/motion_module/models/yolo11n.pt
MOTION_DEVICE=cpu
MOTION_MAX_ACTIVE_RUNS=4
# Gemini 키·모델은 공통 .env에서 읽습니다. 이 파일에서 지정하면 공통값보다 우선합니다.
# GEMINI_API_KEY=
