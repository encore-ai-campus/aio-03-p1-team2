# 모든 실행 환경에서 Supabase를 사용합니다. 실제 키는 커밋하지 않습니다.
APP_ENV=production
# APP_ENV=dev → .env.dev의 원격 설정을 추가로 읽습니다. 모든 모드는 원격 연결만 허용합니다.
AUTH_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 서버 전용 Upstash TCP 주소. 비어 있거나 연결 실패 시 DB 조회로 알림을 확인합니다.
REDIS_URL=

# 비전 설정: 테이블 설치 후 true로 변경합니다. false이면 공용 서버만 실행합니다.
VISION_ENABLED=false
VISION_DATA_DIR=data
# 비우면 VISION_DATA_DIR/jwt_secret에 비전 미리보기용 키를 생성·보존합니다.
VISION_PREVIEW_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
MOTION_MODEL_PATH=data/motion_module/models/yolo11n.pt
MOTION_DEVICE=cpu
MOTION_MAX_ACTIVE_RUNS=4
